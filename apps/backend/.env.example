# Mound Backend Environment Configuration Template
APP_ENV=development
APP_PORT=8000
DEBUG=true

# Database (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql+asyncpg://mound_user:mound_password@localhost:5432/mound_db

# Redis Cache & Sliding-Window Rate Limiting
REDIS_URL=redis://localhost:6379/0

# Embedding Model (sentence-transformers/all-MiniLM-L6-v2 via FastEmbed, 384 dimensions)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Rate Limiting & Linter
RATE_LIMIT_ENABLED=true
EVIDENCE_URL_VERIFICATION_ENABLED=true

# Authentication & JWT Configuration
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Tier-2 LLM Evaluator
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=open-mistral-7b
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Scout Swarm & Autonomous Opportunity Crawler
SCOUT_CRON_INTERVAL_MINUTES=120
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
