# Mound Frontend Environment Configuration Template
# Base URL for the Mound FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Base URL for FastMCP SSE Stream
NEXT_PUBLIC_MCP_URL=http://localhost:8000/mcp

# Optional: Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# If provided, renders official Google Identity Services popup. If omitted, uses dev-mode bypass.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
