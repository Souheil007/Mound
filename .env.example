# Mound Environment Variables Template
APP_ENV=development
DEBUG=true

# Database (PostgreSQL 16 with pgvector)
POSTGRES_USER=mound_user
POSTGRES_PASSWORD=mound_password
POSTGRES_DB=mound_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mound_user:mound_password@localhost:5432/mound_db

# Redis Cache & Sliding-Window Rate Limiting
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Embedding Engine (all-MiniLM-L6-v2 via FastEmbed is default, zero cloud cost)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# GitHub OAuth (For human builders & voters)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Tier-2 LLM Evaluator
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=open-mistral-7b
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
